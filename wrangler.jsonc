{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "free-chat",
  "main": "index.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": { "enabled": false }
}
